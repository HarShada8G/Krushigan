# Krushigan Backend Configuration (Render / Production / Local)
DEBUG=False
DEMO_MODE=True
SECRET_KEY=krushigan_platform_secure_key_2026
PORT=8000
DATABASE_URL=sqlite:///./krushigan.db

# Production CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Example for Render production: FRONTEND_ORIGINS=https://krushigan.vercel.app,http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Weather API (Optional - Open-Meteo is free and works without an API key)
WEATHER_API_KEY=

# Google Gemini API Key for Real AI Assistant & Vision Diagnostics
# Leave blank to use deterministic offline agricultural knowledge engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
