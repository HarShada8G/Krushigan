# Krushigan Platform Unified Environment Configuration

# Backend (FastAPI / Render)
DEBUG=True
DEMO_MODE=True
PORT=8000
SECRET_KEY=replace-with-a-strong-random-secret
DATABASE_URL=sqlite:///./krushigan.db

# Production CORS: Comma-separated list of allowed web frontend URLs
# In production on Render: FRONTEND_ORIGINS=https://krushigan.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# External AI Services
# Google Gemini API Key (multimodal vision + agricultural chatbot)
# If left blank, Krushigan automatically uses verified offline agronomy knowledge base
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend (Vite / Vercel)
# Local: /api
# Production on Vercel: https://<render-service-name>.onrender.com/api
VITE_API_URL=/api
