# Krushigan Frontend Environment Configuration (Vercel / Production / Local)

# In local development:
# Leaving this unset or set to /api uses Vite proxy to localhost:8000
VITE_API_URL=/api

# For Vercel Production Deployment:
# Point to your deployed Render backend API URL (include /api path)
# VITE_API_URL=https://krushigan-backend.onrender.com/api

